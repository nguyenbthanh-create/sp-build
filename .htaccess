# Bloque l'acces direct aux fichiers de developpement / documentation qui ne
# doivent jamais etre servis au navigateur (uniquement presents ici parce que
# le deploiement copie le dossier local tel quel par FTP).

# .git (dossier + tout son contenu, quel que soit le chemin)
RewriteEngine On
RewriteRule (^|/)\.git(/|$) - [F,L]

# Fichiers de doc / dev par nom ou extension
<FilesMatch "(^CLAUDE\.md$|^EVOLUTION\.md$|^REALISATION\.md$|^readme\.txt$|^composer\.(json|lock)$|\.(md|json|sql|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
